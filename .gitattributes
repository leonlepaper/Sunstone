# Все текстовые файлы храним с переводами строк LF.
# Без этого gradlew уедет в репозиторий с виндовыми CRLF и не запустится
# на Linux и macOS — а собирать мод будут в том числе там.
* text=auto eol=lf

# Батник наоборот: ему нужны CRLF, иначе cmd.exe его не поймёт.
*.bat text eol=crlf

# Бинарники git трогать не должен.
*.jar binary
*.png binary
